          "refId": "A",
          "expr": "sum(pcdn_api_24h_security_events_waf) + sum(pcdn_api_24h_security_events_firewall) + sum(pcdn_api_24h_security_events_ratelimit) + sum(pcdn_api_24h_security_events_challenge) + sum(pcdn_api_24h_security_events_ddos) + sum(pcdn_api_24h_security_events_hotlink) + sum(pcdn_api_24h_security_events_bots)",
