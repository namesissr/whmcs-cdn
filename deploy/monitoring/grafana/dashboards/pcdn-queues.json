    {
      "type": "timeseries",
      "title": "Seconds since each job last completed",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "pcdn-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 16,
        "h": 9
