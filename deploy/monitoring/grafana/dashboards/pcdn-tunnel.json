    {
      "type": "timeseries",
      "title": "Capacity used %",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "pcdn-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pcdn-prometheus"
          },
          "refId": "A",
          "expr": "100 * (pcdn_api_edge_tx_mbps{group=\"tunnel\"} > pcdn_api_edge_rx_mbps{group=\"tunnel\"} or pcdn_api_edge_rx_mbps{group=\"tunnel\"}) / (pcdn_api_edge_capacity_mbps{group=\"tunnel\"} > 0)",
          "legendFormat": "{{edge}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
