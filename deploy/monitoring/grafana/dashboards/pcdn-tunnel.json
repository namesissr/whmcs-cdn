{
  "uid": "pcdn-tunnel",
  "title": "Pasargad CDN — Tunnel quality",
  "description": "Tunnel edge group (group=tunnel): availability, load, capacity. Per-site tunnel quality (origin RTT, reconnects) stays per customer in the admin API and is not exported. Needs the optional api-bridge profile (json-exporter over the admin API). Without it these panels show 'No data'. See docs/MONITORING.md.",
  "tags": [
    "pcdn",
    "tunnel"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "pcdn"
      ],
      "asDropdown": true,
      "title": "Pasargad CDN",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Tunnel edges (api-bridge)",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "description": "Needs the optional api-bridge profile (json-exporter over the admin API). Without it these panels show 'No data'. See docs/MONITORING.md."
    },
    {
      "type": "stat",
      "title": "Tunnel edges online",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "pcdn-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pcdn-prometheus"
          },
          "refId": "A",
          "expr": "sum(pcdn_api_edge_online{group=\"tunnel\"})",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
