# Pasargad CDN monitoring — copy to .env (git-ignored) and fill in. See docs/MONITORING.md.
# Secrets below are handed to containers as /run/secrets/* files (Compose `secrets:`), never
# written into a config file. Use `chmod 600 .env`.

# --- what to monitor -------------------------------------------------------------------
# Public base URL of the controller API (the main stack's CONTROLLER_DOMAIN behind Caddy).
CONTROLLER_URL=https://cdn-api.example.com
# Same value as METRICS_TOKEN in the control plane's .env (empty = /metrics is open).
METRICS_TOKEN=
# The separately hosted status page (deploy/status), probed from here. Optional.
STATUS_PAGE_URL=https://status.example.net
# More HTTPS URLs to probe, space separated (HA standby controller, WHMCS, ...). Optional.
PROBE_EXTRA_URLS=

# --- optional admin-API bridge (per-edge load/capacity/uptime, traffic, security) ------
# 1 + `docker compose --profile api-bridge up -d`. Needs ADMIN_API_KEY = FULL CONTROL of the CDN:
# only on a trusted, hardened monitoring host. Read docs/MONITORING.md first.
PCDN_API_BRIDGE=0
PCDN_ADMIN_API_KEY=

# --- Alertmanager channels ------------------------------------------------------------------
# Telegram: bot token from @BotFather, numeric chat id(s), comma separated (groups are negative).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A relay for api.telegram.org when it is blocked (same idea as TELEGRAM_API_URL on the controller)
TELEGRAM_API_URL=https://api.telegram.org
# Outbound proxy for Telegram, e.g. http://10.0.0.5:3128 (optional)
ALERT_HTTPS_PROXY=

# E-mail (all of ALERT_EMAIL_TO, SMTP_SMARTHOST, SMTP_FROM required to enable)
ALERT_EMAIL_TO=
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true

# --- Grafana / UIs --------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# required: a long random password (openssl rand -base64 24)
GRAFANA_ADMIN_PASSWORD=
# public URL if you put Grafana behind a TLS reverse proxy (links in alerts use it)
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_COOKIE_SECURE=false
PROMETHEUS_RETENTION=30d
PROMETHEUS_EXTERNAL_URL=http://127.0.0.1:9090/
ALERTMANAGER_EXTERNAL_URL=http://127.0.0.1:9093/
