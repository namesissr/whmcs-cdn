# Pasargad CDN — object storage server, SeaweedFS (SPEC §16.8, docs/STORAGE.md)
# Copy to .env ON THE STORAGE SERVER ONLY:  cp .env.example .env && chmod 600 .env
# The operator admin identity is generated by bootstrap.sh into s3.json on this server and lives
# nowhere else — never in the controller's .env and never in git.

# Public name of the S3 endpoint; Caddy gets a Let's Encrypt certificate for it automatically
# (A/AAAA record -> this server, ports 80 and 443 open, no CDN proxy in front).
STORAGE_DOMAIN=s3.pasargadmizban.com
ACME_EMAIL=admin@pasargadmizban.com

# Which addresses may reach the operator surface (space separated CIDRs): the controller server(s).
# S3 traffic (customers, edges) is open to everyone; the usage metrics and the IAM API are not.
ADMIN_ALLOW_IPS=127.0.0.1/32

# Pinned image (same version this release was tested against).
SEAWEED_IMAGE=chrislusf/seaweedfs:4.48

# Where the data lives. ONE copy of every object: put RAID1/RAID10 under it, and take backups.
SEAWEED_DATA_DIR=/srv/seaweedfs/data

# Volume size in MiB. Every bucket is its own collection with its own volume(s), so this is the
# granularity of disk allocation: 1 GiB fits many customer buckets on a modest disk; raise it (e.g.
# 30720) when you have few, very large buckets. The volume count itself is not capped (volume.max=0,
# i.e. free disk / this size), which the default of 8 volumes would otherwise do.
VOLUME_SIZE_MB=1024

# Read by bootstrap.sh only (optional): fixed access keys instead of generated ones. The secrets are
# always generated.
# PCDN_ADMIN_KEY=
# PCDN_CONTROLLER_KEY=

# Must match the controller's STORAGE_BUCKET_PREFIX: it is the Resource of the controller identity's
# policy, so a mismatch means the controller may not touch its own buckets.
STORAGE_BUCKET_PREFIX=cdn-
