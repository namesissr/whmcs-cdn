# Pasargad CDN — object storage server (SPEC §16.8, docs/STORAGE.md)
# Copy to .env ON THE STORAGE SERVER ONLY:  cp .env.example .env && chmod 600 .env
# The MinIO root credentials live here and nowhere else — never in the controller's .env or in git.

# Public name of the S3 endpoint; Caddy gets a Let's Encrypt certificate for it automatically
# (A/AAAA record -> this server, ports 80 and 443 open).
STORAGE_DOMAIN=s3.pasargadmizban.com
ACME_EMAIL=admin@pasargadmizban.com

# MinIO root user (break-glass only: bootstrap, upgrades, recovery). Generate the password with:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
MINIO_ROOT_USER=pcdn-root
MINIO_ROOT_PASSWORD=change-me-to-40-random-characters

# Region name reported by MinIO; the controller's STORAGE_REGION must be the same.
MINIO_REGION=us-east-1

# Pinned image. Community images/binaries are no longer published for every release: check the
# MinIO security advisories before upgrading and, if needed, build from source (docs/STORAGE.md).
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MC_IMAGE=minio/mc:latest

# Single node: one data directory (docker-compose.yml)
MINIO_DATA_DIR=/srv/minio/data
# Erasure coding on 4 disks (docker-compose.erasure.yml): one mount point per physical disk,
# each formatted XFS and mounted by UUID in /etc/fstab (docs/STORAGE.md)
MINIO_DISK1=/mnt/disk1
MINIO_DISK2=/mnt/disk2
MINIO_DISK3=/mnt/disk3
MINIO_DISK4=/mnt/disk4

# The MinIO admin API (/minio/admin/*) is only reachable from these addresses (space separated
# CIDRs): the controller server(s). S3 traffic (customers, edges) is open to everyone.
ADMIN_ALLOW_IPS=127.0.0.1/32

# Read by bootstrap.sh only: the access key the controller uses (its secret is generated and
# printed once by bootstrap.sh — put both into the CONTROLLER's .env, not here).
PCDN_CONTROLLER_USER=pcdn-controller
