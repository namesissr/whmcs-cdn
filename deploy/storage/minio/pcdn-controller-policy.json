{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PcdnBucketQuotaAndUsage",
      "Effect": "Allow",
      "Action": [
        "admin:SetBucketQuota",
        "admin:GetBucketQuota",
        "admin:DataUsageInfo"
      ]
    },
    {
      "Sid": "PcdnCustomerBucketsOnly",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::cdn-*",
        "arn:aws:s3:::cdn-*/*"
      ]
    }
  ]
}
