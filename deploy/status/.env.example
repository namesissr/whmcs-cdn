# Status page host — copy to .env. No secrets needed: /status.json is public.
# Domain served by this host. Use a DNS provider OTHER than the CDN's own nameservers, so the
# status page still resolves when ns1/ns2 are down.
STATUS_DOMAIN=status.example.net
# Controller base URL(s), space separated, tried in order (primary first, then the HA standby).
STATUS_UPSTREAMS="https://cdn-api.example.com"
MIRROR_INTERVAL=20
MIRROR_TIMEOUT=10
