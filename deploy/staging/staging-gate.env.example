# Staging gate settings for tools/release/staging-verify.sh (SPEC §23.1, docs/RELEASE.md).
# cp deploy/staging/staging-gate.env.example deploy/staging/staging-gate.env && chmod 600 deploy/staging/staging-gate.env
# The real file is git-ignored. Never point it at production: the gate refuses any controller listed in
# PCDN_PROD_CONTROLLERS or reporting "environment": "production" (PCDN_ENVIRONMENT on the controller).

# staging controller and its admin API key (read from this file only, never from argv)
PCDN_CONTROLLER_URL=https://staging-api.example.com
PCDN_ADMIN_KEY=

# load test: ONE staging edge (IP:port) and a staging test site on it
STAGING_EDGE_TARGET=203.0.113.10:443
STAGING_LOADTEST_HOST=lt.staging.example.com

# nameservers for the preflight DNS checks (comma separated)
STAGING_NS=ns1.staging.example.com,ns2.staging.example.com

# production controllers the gate must never touch (comma separated)
PCDN_PROD_CONTROLLERS=https://cdn-api.example.com
