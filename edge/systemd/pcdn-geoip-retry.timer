[Unit]
Description=Daily retry of the Pasargad CDN GeoIP database while it is missing

[Timer]
# F9: daily, but the service exits immediately when the DB already exists, so this only downloads on
# nodes that are still missing it. The monthly pcdn-geoip.timer handles the routine refresh.
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
