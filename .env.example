# ---- controller -------------------------------------------------------------
# Public name of the controller API (Caddy gets a certificate for it automatically).
# WHMCS "Server Hostname" and every edge's CONTROLLER_URL point here.
CONTROLLER_DOMAIN=cdn-api.pasargadmizban.com
# Used by WHMCS (server "Access Hash"). Generate: openssl rand -hex 32
ADMIN_API_KEY=change-me
# Customer API (SPEC §10.1, /capi/v1): requests allowed per minute for each per-service key.
# In-process sliding window (per controller worker). Default 60.
CAPI_RATE=60
# Directory the controller serves the secret-free edge bundle from for one-command node install
# (SPEC §11.1: GET /edge/bootstrap.sh|bundle.tar.gz|version). Default: the repo's edge/ tree next
# to the controller package (<repo>/edge); in the container set it to the baked copy of edge/.
# Unset/missing -> those routes return 404 and the panel falls back to manual git/scp install.
# EDGE_BUNDLE_DIR=/app/edge

POSTGRES_PASSWORD=change-me

# ---- DNS -------------------------------------------------------------------
# Nameservers customers must set on their domains (need glue/A records, see README).
NAMESERVERS=ns1.pasargadmizban.com,ns2.pasargadmizban.com
SOA_EMAIL=hostmaster.pasargadmizban.com
# Shared API key of every PowerDNS server. Generate: openssl rand -hex 24
PDNS_API_KEY=change-me
# Every zone is written to all of these (comma separated). Add ns2's API when it runs on another server:
# PDNS_API_URL=http://pdns:8081,http://NS2_PRIVATE_IP:8081
PDNS_API_URL=http://pdns:8081
DEFAULT_TTL=300
PROXIED_TTL=60

# GeoDNS: answer Iranian visitors with "home" edges and everyone else with "global" edges.
# Requires the PowerDNS geoip backend + country database on EVERY nameserver (README, GeoDNS):
# COMPOSE_FILE=docker-compose.yml:deploy/geoip.override.yml
GEOIP_ENABLED=false
GEO_HOME_COUNTRY=IR
# Resolvers that never send the visitor's subnet (Cloudflare 1.1.1.1 and Quad9 9.9.9.9 by default, list in
# GEO_NO_ECS_RESOLVERS): their visitors get the home pool (home | global | geo)
GEO_NO_ECS_POOL=home
# optional: only when that resolver is in one of these countries (where Iranian traffic lands,
# find them with GEO_LOG); its users elsewhere, e.g. the US, get the global pool. Empty = everywhere
GEO_NO_ECS_COUNTRIES=
# addresses missing from the country database: home | global
GEO_UNKNOWN_POOL=home
# log each GeoDNS decision in PowerDNS (docker compose logs pdns | grep pcdn-geo); for diagnosis only
GEO_LOG=false
# every 10 minutes ask each nameserver which pool a home and a foreign visitor get; alert on errors
GEO_CHECK=true
# DNS address of each nameserver for that check (default: the hosts of PDNS_API_URL, port 53)
# PDNS_DNS_ADDRS=pdns:53,NS2_IP:53
# inside the chosen pool: random | all | hashed | first | pickclosest
LUA_SELECTOR=random
# PowerDNS also probes the edges of the chosen pool itself (never moves visitors to the other pool)
EDGE_PROBE=true

# ---- SSL (Let's Encrypt via DNS-01) -----------------------------------------
ACME_EMAIL=admin@pasargadmizban.com
ACME_SERVER=letsencrypt

# ---- tuning ----------------------------------------------------------------
EDGE_OFFLINE_SECONDS=180
# raise the "node offline" alert this many seconds after a node's last report (it stays in DNS
# until EDGE_OFFLINE_SECONDS). Keep it >= the agent's HEARTBEAT_INTERVAL (60s) to avoid false alarms.
EDGE_ALERT_SECONDS=90
# warn when a node's load average per CPU core stays above this, or (if the agent reports them)
# its disk/memory usage passes these percentages
EDGE_CPU_ALERT=4
EDGE_DISK_ALERT=90
EDGE_MEM_ALERT=95
# load shedding: an edge using this % of its capacity_mbps leaves DNS answers while another edge of
# its group+region stays; it comes back below (this - 15)%. Edges with capacity_mbps 0 are never shed.
EDGE_SHED_PERCENT=90
NS_CHECK_INTERVAL=600
SCHEDULER_INTERVAL=60

# ---- synthetic edge probes (SPEC §8.1) --------------------------------------
# every ~60s the controller itself fetches http://<node>/__pcdn/health (Host: health.pcdn)
# from each enabled node to catch a node that still reports in but serves errors (e.g. a bad
# nginx -t). Also probes the IPv6 address when the node has one and PROBE_IPV6=true (a node is
# OK if either family answers). After PROBE_FAIL_CHECKS consecutive failures a warning is sent.
PROBE_ENABLED=true
PROBE_TIMEOUT=5
PROBE_IPV6=true
PROBE_FAIL_CHECKS=3

# ============================================================================
# Operations — see docs/OPERATIONS.md (راهنمای عملیات به فارسی)
# ============================================================================

# ---- encryption at rest / رمزنگاری کلید خصوصی گواهی‌ها در دیتابیس ----------------
# Fernet key (urlsafe base64, 32 bytes). Generate:  docker compose run --rm controller python -m app.manage gen-key
# Rotation: put the NEW key first and keep the old one after a comma, restart,
# run `python -m app.manage rotate-key`, then remove the old key.
# Every controller (both HA servers) MUST use the same value. Keep a copy OUTSIDE this server:
# without it, encrypted private keys in the database and in backups cannot be read.
# کلید را جایی غیر از همین سرور هم نگه دارید؛ بدون آن کلیدهای خصوصی قابل بازیابی نیستند.
DATA_ENCRYPTION_KEY=

# ---- alerts: Telegram / هشدار تلگرام ------------------------------------------
# Bot token from @BotFather and one or more chat ids (user, group or channel; comma separated).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# api.telegram.org is filtered in Iran: point this at a relay / reverse proxy outside Iran
# (e.g. https://tg.example.com  ->  https://api.telegram.org), or set HTTPS_PROXY for the controller.
# TELEGRAM_API_URL=https://api.telegram.org
# HTTPS_PROXY=http://proxy.example.com:3128

# ---- alerts: e-mail (SMTP) / هشدار ایمیلی ----------------------------------------
SMTP_HOST=
# default: 587 for starttls, 465 for ssl, 25 for none
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cdn-alerts@pasargadmizban.com
# starttls | ssl | none
SMTP_SECURITY=starttls
# comma separated recipients
ALERT_EMAILS=
# repeat an unresolved alert every N hours (0 = never repeat)
ALERT_REMINDER_HOURS=6
# warn when an auto-renewed certificate expires within N days
ALERT_CERT_DAYS=7
ALERT_SUBJECT_PREFIX=[Pasargad CDN]

# ---- backups / پشتیبان‌گیری خودکار ----------------------------------------------
# Daily archive of the controller DB (pg_dump), the PowerDNS DB (zones + DNSSEC keys) and acme.sh home.
BACKUP_ENABLED=true
# hour of day in UTC (2 = 05:30 Tehran)
BACKUP_HOUR=2
# how many archives to keep locally (and remotely unless BACKUP_S3_KEEP is set)
BACKUP_KEEP=14
# BACKUP_DIR=/data/backups
# Encrypts the archive (AES-256-GCM, key from scrypt). Store the passphrase OUTSIDE the server.
# رمز پشتیبان را جایی بیرون از سرور نگه دارید.
BACKUP_PASSPHRASE=
# Optional S3-compatible upload (ArvanCloud Object Storage, MinIO, AWS...). Path-style URLs.
# ArvanCloud example: BACKUP_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir  BACKUP_S3_REGION=ir-thr-at1
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=pcdn-backups/
# BACKUP_S3_KEEP=30

# ---- high availability / دسترس‌پذیری بالا ----------------------------------------
# Name shown in /healthz/deep and alerts (default: container hostname).
# INSTANCE_NAME=server-a
# Two-server setup: list both PostgreSQL servers; libpq connects to the writable one.
# DATABASE_URL=postgresql+psycopg://pcdn:PASSWORD@/pcdn?host=db:5432&host=10.0.0.2:5432&target_session_attrs=read-write&connect_timeout=5
